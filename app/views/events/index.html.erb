<h1><span style="color: red;">♥</span> Daily Pattern</h1>

<% @years.each do |year| %>
  <h2><%= year %></h2>
  <div class="cal-heatmap"
    data-controller="heatmap"
    data-heatmap-url-value="<%= heatmap_data_events_path %>"
    data-heatmap-year-value="<%= year %>"
    style="margin-bottom: 2em;">
  </div>
<% end %>

<%= render "form", event: @event %>

<details style="margin-top: 3em;">
  <summary>Recent Entries - <%= @recent_events.count %> Total</summary>
  <ul>
    <% @recent_events.each do |event| %>
      <li><%= event.date %> <%= event.time.strftime("%H:%M") %> - <%= event.comment %></li>
    <% end %>
  </ul>
</details>