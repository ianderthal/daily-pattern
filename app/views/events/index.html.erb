<h1><span style="color: red;">♥</span> Daily Pattern</h1>

<div id="cal-heatmap"
  data-controller="heatmap"
  data-heatmap-url-value="<%= heatmap_data_events_path %>" style="margin: 5em 0">
</div>

<%= render "form", event: @event %>

<details style="margin-top: 3em;">
  <summary>Recent Entries</summary>
  <ul>
    <% @recent_events.each do |event| %>
      <li><%= event.date %> <%= event.time.strftime("%H:%M") %> - <%= event.comment %></li>
    <% end %>
  </ul>
</details>